# Deployment instance configuration.
INSTANCE_NAME=""
INSTANCE_DIR=""
ENVIRONMENT="Production"
BACKEND_PORT=""
FRONTEND_PORT=""
DATABASE_REVISION="0"

# Backend and frontend runtime configuration.
ASPNETCORE_ENVIRONMENT="Production"
ASPNETCORE_HTTP_PORTS="8080"
DATABASE_PATH="/data/database.db"
FRONTEND_ORIGIN=""
API_URL="http://backend:8080"
LOG_DIRECTORY="/logs"

# Google OpenID Connect application registration.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated immutable Google OpenID Connect subjects (`sub`) allowed to share this ledger.
GOOGLE_ALLOWED_SUBJECTS=""

# Auth.js session encryption. Deployment scripts generate this when it is absent.
AUTH_SECRET=""

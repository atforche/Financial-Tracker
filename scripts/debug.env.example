# This file is copied to debug/.env by ./scripts/debug_scripts.py create or stack-up.
# AUTH_MODE=development never uses Google and is rejected outside ASPNETCORE_ENVIRONMENT=Development.
AUTH_MODE="development"
DEVELOPMENT_AUTH_SUBJECT="local-developer"
DEVELOPMENT_AUTH_ADDITIONAL_SUBJECTS="local-standard,local-read-only"
DEVELOPMENT_AUTH_READ_ONLY_SUBJECTS="local-read-only"
AUTH_SECRET=""
PUBLIC_ORIGIN="http://localhost:3001"
AUTH_URL="http://localhost:3001"

ASPNETCORE_ENVIRONMENT="Development"
ASPNETCORE_HTTP_PORTS="8081"
DATABASE_PATH=""
FRONTEND_ORIGIN="http://localhost:3001"
API_URL="http://localhost:8081"
LOG_DIRECTORY=""
